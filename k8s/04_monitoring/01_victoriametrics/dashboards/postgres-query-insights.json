        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "round(sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_total_exec_time_ms{datname=~\"$database\"}[$__range])) and (sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])) >= 1), 0.01)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "round((sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_total_exec_time_ms{datname=~\"$database\"}[$__range])) / clamp_min(sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])), 1)) and (sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])) >= 1), 0.01)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "round(max by (datname, usename, queryid, query) (max_over_time(cnpg_pg_stat_statements_max_exec_time_ms{datname=~\"$database\"}[$__range])) and (sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])) >= 1), 0.01)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "round(sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_rows{datname=~\"$database\"}[$__range])) and (sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])) >= 1), 1)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "round((100 * sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_shared_blks_hit{datname=~\"$database\"}[$__range])) / clamp_min(sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_shared_blks_hit{datname=~\"$database\"}[$__range]) + increase(cnpg_pg_stat_statements_shared_blks_read{datname=~\"$database\"}[$__range])), 1)) and (sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])) >= 1), 0.01)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F"
        }
      ],
