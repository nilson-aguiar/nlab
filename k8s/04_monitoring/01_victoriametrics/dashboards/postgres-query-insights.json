      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "round(sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])) and (sum by (datname, usename, queryid, query) (increase(cnpg_pg_stat_statements_calls{datname=~\"$database\"}[$__range])) >= 1), 1)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
