      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (datname, usename, queryid, query) (rate(cnpg_pg_stat_statements_total_exec_time_ms{datname=~\"$database\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{datname}} ({{usename}}): {{query}}",
          "range": true,
          "refId": "A"
