          "rawQuery": true,
          "rawSql": "SELECT \n  d.datname AS \"Database\",\n  s.temp_blks_written AS \"Temp Blks Written\",\n  s.temp_blks_read AS \"Temp Blks Read\",\n  s.calls AS \"Calls\",\n  round(s.total_exec_time::numeric, 2) AS \"Total Time (ms)\",\n  s.query AS \"Query Preview\"\nFROM pg_stat_statements s\nJOIN pg_database d ON s.dbid = d.oid\nWHERE ('$database' = 'ALL' OR d.datname = '$database') AND s.temp_blks_written > 0\nORDER BY s.temp_blks_written DESC\nLIMIT 20;",
