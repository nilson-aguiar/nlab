      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-cluster"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  d.datname AS \"Database\",\n  s.calls AS \"Calls\",\n  round(s.total_exec_time::numeric, 2) AS \"Total Time (ms)\",\n  round((s.total_exec_time / nullif(s.calls, 0))::numeric, 2) AS \"Mean Time (ms)\",\n  round(s.max_exec_time::numeric, 2) AS \"Max Time (ms)\",\n  s.rows AS \"Rows\",\n  round((100.0 * s.shared_blks_hit / nullif(s.shared_blks_hit + s.shared_blks_read, 0))::numeric, 2) AS \"Cache Hit %\",\n  s.query AS \"Query Preview\"\nFROM pg_stat_statements s\nJOIN pg_database d ON s.dbid = d.oid\nWHERE ('$database' = 'ALL' OR d.datname = '$database')\nORDER BY s.total_exec_time DESC\nLIMIT 30;",
          "refId": "A"
        }
      ],
      "title": "Top Slowest Queries by Total Execution Time (pg_stat_statements)",
      "type": "table"
    },
