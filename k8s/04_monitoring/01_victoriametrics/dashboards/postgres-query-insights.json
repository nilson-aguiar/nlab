          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  pid AS \"PID\",\n  datname AS \"Database\",\n  usename AS \"User\",\n  application_name AS \"Application\",\n  round(extract(epoch FROM (now() - query_start))::numeric, 2) AS \"Duration (s)\",\n  state AS \"State\",\n  query AS \"Current Query\"\nFROM pg_stat_activity\nWHERE state != 'idle' AND pid <> pg_backend_pid()\n  AND ('$database' = 'ALL' OR datname = '$database')\nORDER BY query_start ASC;",
