          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(cnpg_pg_database_size_bytes{cluster=~\"$cluster\", datname=~\"$database\", datname!~\"template.*\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "title": "Current Database Size (Ranked)",
      "type": "bargauge"
